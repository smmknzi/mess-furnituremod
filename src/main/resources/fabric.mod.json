{
	"schemaVersion": 1,
	"id": "furnituremod",
	"version": "${version}",
	"name": "Mess's Furniture",
	"description": "A Vanilla+ Mod that adds basic and simplistic furniture to Minecraft.",
	"authors": [
		"Mess"
	],
	"contact": {
		"homepage": "",
		"sources": "https://github.com/smmknzi/mess-furnituremod"
